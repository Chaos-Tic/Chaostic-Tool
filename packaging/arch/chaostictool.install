## ChaosticTool pacman scriptlet: notify (never auto-remove) on package removal.
## The external security tools ChaosticTool installs at runtime are not owned by
## this package; point the user at the manifest-driven uninstaller instead.

pre_remove() {
    MANIFEST=/var/lib/chaostictool/manifest
    if [ -f "$MANIFEST" ]; then
        count=$(grep -cvE '^[[:space:]]*(#|$)' "$MANIFEST" 2>/dev/null || true)
        [ -n "$count" ] || count=0
        if [ "$count" -gt 0 ]; then
            echo "ChaosticTool recorded $count installed item(s) in $MANIFEST."
            echo "Removing this package does NOT remove those external tools, repository"
            echo "entries or system edits. To review and remove them, run:"
            echo "    sudo chaostictool-uninstall --dry-run   # preview"
            echo "    sudo chaostictool-uninstall             # remove what ChaosticTool installed"
            echo "The manifest is kept so this can also be done later."
        fi
    fi
}
